{
  "name": "bsru-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "BSRU Workshop with local SQLite and PostgreSQL deployment support",
  "engines": {
    "node": "^22.13.0 || 24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:local": "node scripts/dev.js --local",
    "start": "node server.js",
    "check": "node scripts/check.js",
    "db:status": "node scripts/database.js status",
    "db:backup": "node scripts/database.js backup",
    "db:migrate": "node scripts/database.js migrate",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write \"api/**/*.js\" \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"public/assets/js/**/*.js\" \"public/assets/css/**/*.css\" public/index.html server.js package.json vercel.json",
    "format:check": "prettier --check \"api/**/*.js\" \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"public/assets/js/**/*.js\" \"public/assets/css/**/*.css\" public/index.html server.js package.json vercel.json"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "linkedom": "^0.18.14",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  }
}
