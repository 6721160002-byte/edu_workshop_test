{
  "name": "bsru-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "BSRU Workshop local Node.js and SQLite application",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node server.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"public/assets/js/**/*.js\" \"public/assets/css/**/*.css\" public/index.html server.js package.json",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"public/assets/js/**/*.js\" \"public/assets/css/**/*.css\" public/index.html server.js package.json"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
