# Set these in Vercel Project Settings > Environment Variables.
# Use a dedicated PostgreSQL database; do not paste secrets into chat or Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# Optional: pin the public origin if a proxy changes the Host header.
# APP_ORIGIN=https://your-project.vercel.app
