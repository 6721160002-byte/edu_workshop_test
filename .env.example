# Set these in Vercel Project Settings > Environment Variables.
# Use a dedicated PostgreSQL database; do not paste secrets into chat or Git.
# Uncomment with real values for Supabase/PostgreSQL deployment.
# Leaving DATABASE_URL unset uses local SQLite during development.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# The downloaded Supabase CA is bundled at database/certs/prod-ca-2021.crt.
# Optional override for a different project's CA:
# DATABASE_CA_FILE=database/certs/prod-ca-2021.crt
# DATABASE_CA_CERT may also contain PEM text (for deployment environments).
# Migration and connection checks: npm run db:status / db:migrate
# Follow SUPABASE_SETUP_TH.md before starting against an empty cloud database.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# Optional: pin the public origin if a proxy changes the Host header.
# APP_ORIGIN=https://your-project.vercel.app

# Normal signup/login; email OTP is required only to reset a password.
# Accounts are stored in the application's users table, not Supabase Auth.
# See PASSWORD_RESET_SETUP_TH.md for a free Gmail setup from the beginning.
REGISTRATION_PROVIDER=password
# Optional owner-requested readable copies in user_passwords (default OFF).
# Anyone with privileged database/backup access can read these passwords.
# Only new password signups/resets are recorded; old hashes cannot be recovered.
# See SUPABASE_PASSWORD_VIEW_TH.md before enabling. Never use this in frontend env.
STORE_PLAINTEXT_PASSWORDS=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_USER=your.website.sender@gmail.com
# Use a Google App Password, never the Gmail account's normal password.
# SMTP_PASSWORD=REPLACE_WITH_GOOGLE_APP_PASSWORD
# Optional; for Gmail use the same sender address as SMTP_USER.
# SMTP_FROM=BSRU Workshop <your.website.sender@gmail.com>

# Compatibility settings for previously deployed Firebase registrations.
# Only set REGISTRATION_PROVIDER=firebase to use that older signup flow.
# FIREBASE_API_KEY=AIza_REPLACE_WITH_YOUR_FIREBASE_WEB_API_KEY
# Optional return address after Firebase's hosted verification/reset page.
# Add this host to Firebase Authentication > Settings > Authorized domains.
# FIREBASE_CONTINUE_URL=https://your-project.vercel.app/

# Legacy Resend OTP signup, only when REGISTRATION_PROVIDER=resend.
# RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
# OTP_FROM=BSRU Workshop <no-reply@your-verified-domain.example>
